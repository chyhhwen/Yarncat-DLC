/* ═══ 毛球貓 DLC：健身貓 ═══
   裝法：把這個檔案放進 圖片\YarnCat\dlc（狀態視窗「系統」→「打開 DLC 資料夾」；macOS 是 ~/Pictures/YarnCat/dlc），重開毛球貓。
   「毛色」多了「健身」；地上多了臥推椅、跑步機、高拉背機，每一隻貓都會去練（「家具」可以個別收起來）。
   要毛球貓 1.5.0 以上，商店版、GitHub 版都可以。以前的 boss-gym.yarncat 拆成了這個和 boss.yarncat（老大貓），舊的要刪掉。

   這個檔案是 JavaScript：毛球貓開機時讀進來跑（主程式 src/index.html 的「DLC」），主程式的東西都用得到；
   角色、家具要提供哪些函式，見主程式的「角色」「DLC 家具」。這裡的 const、function 只有這個檔案看得到，不會跟主程式撞名。
   測試：用瀏覽器打開主程式的 src/index.html，把這個檔案拖進視窗（會重新整理一次），按 c 換到健身。
   不管哪一隻，閒著時按 b 臥推、m 跑步機、l 高拉背機。 */
if (typeof furnCall !== 'function') throw new Error('要毛球貓 1.5.0 以上');   // 1.4 的主程式還不會擺 DLC 的家具

Object.assign(C, {
  Hb: '#e0463c', Gp: '#4a4d5c', Gh: '#8a8fa3', Gl: '#6d7184', Bp: '#3d4a6b', Bq: '#5b6a90',   // 健身貓的頭帶；健身器材：槓片和鐵架、椅墊
  Tb: '#2f3140', Gs: '#1f3b2f', Gn: '#7be08a',          // 健身器材：跑帶、跑步機螢幕、速度格
});
Object.assign(COATS, {
  gym: { F: '#ece7dd', D: '#cfc5b3', W: '#ffffff', G: '#6fb2dc' },    // 健身貓：白貓、藍眼睛，頭帶見「健身貓」
});
Object.assign(COAT_NAMES, { gym: '健身' });

/* ═══ 健身貓：綁紅頭帶的白貓（毛色選「健身」就是牠） ═══
   外觀：沿用每個姿勢，額頭綁一條紅頭帶，腦後垂一小段結（dress）。
   器材每一隻貓都會用（見下面的「健身器材」），健身貓比較常自己去練。 */
CHARS.gym = {
  dress(pose, who) {                                   // 紅頭帶
    const parts = pose[0].slice(), det = pose[1].slice();
    const head = sideHead(parts);
    if (head) {
      const [hx, hy, , hh] = head;
      let by = hy + 1;                                 // 綁在眼睛上面一格；頭比較扁（壓低、扒地、炸毛）的姿勢眼睛比較高，跟著往上
      for (const [x, y, , , c] of pose[1])
        if ((c === 'G' || c === 'E') && x >= hx && x < hx + 8 && y >= hy && y < hy + hh) by = Math.max(hy, Math.min(by, y - 1));
      det.push([hx, by, 8, 1, 'Hb']);                  // 額頭一圈
      parts.push([hx - 2, by, 2, 1, 'Hb'], [hx - 3, by + 1, 1, 1, 'Hb']);   // 腦後打結垂下來
    } else if (who === 'cat' && cat.state === 'press') det.push([5, -3, 9, 1, 'Hb']);   // 躺著臥推：臉倒過來不是側臉，頭帶綁在額頭（眼睛下面）
    return [parts, det];
  },
};

/* ═══ 健身器材：臥推椅、跑步機、高拉背機（家具，每一隻貓都會用） ═══
   跟貓砂盆它們一樣擺在地上，可以拖、拎高放開會掉下來；狀態視窗「家具」可以個別收起來（見主程式的「DLC 家具」）。
   每一件隔一陣子貓就會自己去練一次，健身貓比較勤快。點一下器材，叫貓馬上過去練；練的時候再點一下：
     臥推椅（bench）：躺上去、把槓鈴從架子拿下來推幾下（推到底咬緊牙）、放回架子。從側面看，槓鈴是一片圓槓片。
     跑步機（mill）：  站上去原地跑；點一下加速（1～3）。最快撐太久會被往後擠，從尾巴甩出去、落地炸毛。
     高拉背機（lat）： 坐上去伸手抓握把往下拉，配重片跟著升降；點一下加重量（1～3）。最重拉不動，被拉離座椅，鬆手掉下來炸毛。
   貓在器材上時 cat.in 是那件的代號。練到一半拖動器材、收起來、把貓拎起來：貓掉下來，槓鈴回到架子、握把回到頂上。 */
const GO = { bench: 'toBench', mill: 'toMill', lat: 'toLat' };   // 走過去的狀態
const USE = { bench: 'press', mill: 'run', lat: 'pull' };       // 在上面練的狀態
// 怎麼上去：從器材哪邊走過去（from）、跳到哪（x, y，相對器材）、跳多高（h）。下來也從 from 那邊跳
const MOUNT = { bench: { from: -20, x: -1, y: -8, h: 8 }, mill: { from: -26, x: -4, y: -5, h: 6 }, lat: { from: -20, x: -5, y: -10, h: 8 } };
const HIT = {                                          // 點得到的地方（相對器材）：[x0, y0, x1, y1]
  bench: [[-13, -9, 11, 1], [-3, -28, 8, -8]],         // 椅子、架子
  mill: [[-18, -6, 17, 1], [5, -26, 17, 0]],           // 跑帶、柱子和螢幕
  lat: [[-12, -11, 1, 1], [7, -45, 15, 1], [-1, -45, 11, -41]],   // 座椅、柱子、頂上的橫桿
};
// 在上面練時貓的點擊範圍（相對貓）：跑步機窄一點，前面的螢幕才點得到
const BOX = { bench: [-16, -16, 14, 4], mill: [-13, -17, 9, 1], lat: [-14, -23, 8, 1] };
const KEY = { bench: 'b', mill: 'm', lat: 'l' };     // 網頁版測試：閒著時按一下，馬上去練
Object.assign(HALF, { bench: 13, mill: 18, lat: 17 });   // 拉背機的座椅在左邊：半寬放寬，貓坐上去時才不會被擠出畫面
Object.assign(TOP, { bench: 28, mill: 26, lat: 45 });
cat.lift = false; cat.reps = 0;                        // 臥推：槓鈴在手上；這組要推幾下
cat.fast = 0; cat.L = 17; cat.strain = 0;              // fast：跑步機最快撐了多久；L：拉背時手臂多長；strain：最重拉不動，撐了多久
Object.assign(ZH, { toBench: '走去臥推椅', press: '臥推', toMill: '走去跑步機', run: '在跑步機上跑步', toLat: '走去高拉背機', pull: '拉背' });
Object.assign(RATE, { toBench: 9, press: 99, toMill: 9, run: 99, toLat: 9, pull: 99 });   // 99：動畫自己算，不靠 frame
BUSY.push('press', 'run', 'pull');                     // 練到一半，丟毛球、換玩具都不理
// 器材真的被拖走了嗎：按下去還沒怎麼動（可能只是點一下：加速、加重量）不算
const dragged = g => g.held && (!drag || drag.obj !== g || drag.moved >= 1.5);
const gearReady = k => FURN[k] && FURN[k].on && !dragged(FURN[k]) && FURN[k].y >= FLOOR;
const using = k => cat.in === k && cat.state === USE[k];   // 貓正在這件上面練

function goGear(k) {                                   // 去練（點了器材、或時間到了）；正在走去別件的話，改走過來
  if (cat.state === GO[k]) return true;
  if (!gearReady(k) || quiet || cat.energy < 30 || cat.perch || cat.in) return false;
  if (['sleep', 'pounce', 'leap', 'clutch', ...BUSY].includes(cat.state)) return false;
  setState(GO[k], trek(0.6));
  return true;
}
function mount(g) {                                    // 走到上來的那一頭了：跳上去，站穩就開始練
  const k = g.kind, m = MOUNT[k];
  cat.in = k;
  hop(g.x + m.x, g.y + m.y, m.h, 26, () => {
    if (!gearReady(k) || Math.abs(cat.x - g.x - m.x) > 2) return tumble();   // 跳到一半器材被搬走了
    cat.dir = 1;
    g.cd = myCoat === 'gym' ? rand(21600, 43200) : rand(43200, 86400);   // 這件下一次自己來練：健身貓 6～12 分鐘後，其他貓 12～24 分鐘後
    if (k === 'bench') { cat.lift = false; cat.reps = Math.round(rand(5, 9)); setState('press', 99999); }
    if (k === 'mill') { cat.fast = 0; setState('run', rand(600, 1000)); }
    if (k === 'lat') { cat.strain = 0; cat.L = 17; setState('pull', rand(500, 800)); }
  });
}
function leaveGear(k) {                                // 練完：從上來的那一頭跳下來
  cat.lift = false;
  hop(FURN[k].x + MOUNT[k].from, FLOOR, 6, 24, () => { cat.in = null; setState('lick', rand(90, 150)); });
}
function oops(g, vx) {                                 // 被甩出去、鬆手：往後飛，落地炸毛
  cat.in = null; cat.vx = vx; cat.vy = -1.6; g.flung = true;
  bang(cat.x, cat.y - 26);
  setState('fall', 999);
}

/* ── 臥推椅 ── */
// 槓片：(0, 0) 是正中間，側面看是一片圓的，中間是套在槓上的孔
const PLATE_P = [[-3, -2, 7, 5, 'Gp'], [-2, -3, 5, 7, 'Gp']];
const PLATE_D = [[-1, -1, 3, 3, 'Gh'], [0, 0, 1, 1, 'O'], [-2, -2, 1, 1, 'Gl']];
const RACK = [1, -24];                                 // 槓鈴掛在架子上時，槓片的中心（相對椅子）：跟手臂伸直時一樣高，舉起來不用跳
function pressPose(L, strain) {                        // 躺在椅墊上、肚子朝上，兩隻前腳往上撐 L 格；strain：咬緊牙閉眼（健身貓的頭帶見「健身貓」）
  const parts = [
    [-14, -3, 2, 2, 'F'], [-15, -1, 2, 4, 'F'],        // 尾巴從椅子尾巴垂下去
    [-10, -5, 15, 5, 'F'], [-9, -6, 12, 1, 'F'],       // 背貼著椅墊
    [-9, -10, 2, 5, 'F'], [-10, -11, 2, 1, 'F'], [-6, -9, 2, 4, 'F'],   // 後腳彎起來
    [0, -5 - L, 2, L, 'F'], [3, -5 - L, 2, L, 'F'],    // 前腳往上撐
    [5, -7, 9, 6, 'F'], [5, -1, 2, 1, 'F'], [12, -1, 2, 1, 'F'],   // 臉倒過來，耳朵貼著椅墊
  ];
  const det = [
    [-7, -6, 9, 1, 'W'], [-6, -3, 1, 2, 'D'], [-3, -3, 1, 2, 'D'],
    [-10, -11, 2, 1, 'W'], [-6, -9, 2, 1, 'W'], [0, -5 - L, 2, 1, 'W'], [3, -5 - L, 2, 1, 'W'],
    [8, -6, 3, 2, 'W'], [9, -5, 1, 1, 'P'], [5, -1, 1, 1, 'P'], [13, -1, 1, 1, 'P'],
  ];
  if (strain) det.push([6, -4, 2, 1, 'E'], [11, -4, 2, 1, 'E'], [9, -6, 1, 1, 'W'], [8, -7, 3, 1, 'O']);   // 閉眼、咬牙
  else det.push([7, -4, 1, 1, 'E'], [11, -4, 1, 1, 'E'], [7, -5, 1, 1, 'G'], [11, -5, 1, 1, 'G']);
  return [parts, det];
}
// 臥推進行到哪：0～20 躺好，20～40 手伸上去拿槓鈴，接著每 50 格推一下，推完 30 格放回架子，再 20 格手放下來
const PRESS_LIE = 20, PRESS_UP = 40, REP = 50;
const pressEnd = () => PRESS_UP + cat.reps * REP + 50;
function armLen() {                                    // 現在手臂往上撐幾格（3 放在胸口、8 伸直）
  const t = cat.t;
  if (t < PRESS_LIE) return 3;
  if (t < PRESS_UP) return 3 + 5 * (t - PRESS_LIE) / (PRESS_UP - PRESS_LIE);
  const r = t - PRESS_UP;
  if (r < cat.reps * REP) return 3 + 5 * (0.5 + 0.5 * Math.cos(2 * Math.PI * r / REP));   // 從伸直放下來到胸口，再推上去
  if (r < cat.reps * REP + 30) return 8;
  return Math.max(3, 8 - 5 * (r - cat.reps * REP - 30) / 20);
}
function stepPress(g) {
  cat.x = g.x + MOUNT.bench.x; cat.y = g.y + MOUNT.bench.y; cat.dir = 1;
  const r = cat.t - PRESS_UP;
  if (cat.t === PRESS_UP) cat.lift = true;             // 從架子上拿下來
  if (r === cat.reps * REP + 30) cat.lift = false;     // 放回架子
  if (r >= 0 && r < cat.reps * REP) {
    cat.energy -= 0.03;
    if (cat.t % 37 === 0) sweat(9, -7);
  }
  if (cat.t >= pressEnd()) {
    note('bench_sets'); note('reps', cat.reps);
    sparkle(cat.x + 2, cat.y - 18);                    // 練完一組：亮晶晶
    leaveGear('bench');
  }
}
function drawBench(g) {                                // 臥推椅；槓鈴沒在手上就掛在架子上
  const x = Math.round(g.x), y = Math.round(g.y);
  drawRects(x, y, [
    [-10, -6, 2, 6, 'Gp'], [7, -6, 2, 6, 'Gp'],        // 椅腳
    [5, -26, 2, 18, 'Gp'], [3, -26, 2, 1, 'Gp'],       // 架子、掛鉤
    [-12, -8, 22, 3, 'Bp'],                            // 椅墊
  ], [[-11, -8, 20, 1, 'Bq'], [6, -26, 1, 18, 'Gl']]);
  if (!(cat.state === 'press' && cat.lift)) drawRects(x + RACK[0], y + RACK[1], PLATE_P, PLATE_D);
}

/* ── 跑步機 ── */
const MILL_SPEED = [0, 1, 1.6, 2.4];                   // 每一段速度：腳步多快（倍）
function stepRun(g) {
  cat.dir = 1; cat.y = g.y + MOUNT.mill.y;
  g.phase = (g.phase + MILL_SPEED[g.speed] * 0.7) % 30;   // 跑帶往後捲
  cat.energy -= 0.012 * g.speed;
  note('run_sec');
  if (cat.t % Math.round(48 / g.speed) === 0) sweat(10, -14);
  cat.fast = g.speed === 3 ? cat.fast + 1 : 0;
  if (cat.fast > 150) cat.x -= 0.3;                    // 最快撐不住：被往後擠
  else cat.x += (g.x + MOUNT.mill.x - cat.x) * 0.1;    // 慢下來就跑回原位
  if (cat.x < g.x - 14) return oops(g, -1.4);          // 從尾巴甩出去
  if (cat.t > cat.dur && g.speed < 3) { note('treadmill'); leaveGear('mill'); }   // 跑夠了（最快的時候下不來）
}
function drawMill(g) {                                 // 跑步機：底座、跑帶（紋路往後捲）、前面的柱子、扶手、小螢幕顯示速度
  const x = Math.round(g.x), y = Math.round(g.y);
  const det = [[13, -22, 1, 19, 'Gl'], [10, -24, 6, 2, 'Gs']];
  for (let i = 0; i < 5; i++) {
    const sx = ((i * 6 - Math.round(g.phase)) % 30 + 30) % 30 - 15;
    det.push([sx, -5, 2, 1, 'Gl']);
  }
  for (let i = 0; i < g.speed; i++) det.push([10 + i * 2, -24, 1, 2, 'Gn']);
  drawRects(x, y, [
    [-17, -3, 34, 3, 'Gp'],                            // 底座
    [-16, -5, 31, 2, 'Tb'],                            // 跑帶
    [12, -22, 2, 19, 'Gp'],                            // 柱子
    [6, -16, 7, 1, 'Gp'],                              // 扶手
    [9, -25, 8, 4, 'Gp'],                              // 螢幕
  ], det);
}

/* ── 高拉背機 ── */
const PULL = 70;                                       // 拉一下幾格
const LAT_REST = -41;                                  // 沒人拉時握把在哪（相對器材，握把頂端）：掛在滑輪底下
function pullPose(L, strain) {                         // 坐在椅墊上，一隻前腳往上抓握把（手臂 L 格長）；仰頭看著握把
  const parts = [
    [-12, -2, 8, 2, 'F'], [-13, -4, 2, 2, 'F'],        // 尾巴
    [-9, -7, 9, 7, 'F'], [-3, -13, 7, 11, 'F'],        // 後腿、胸口
    [-1, -20, 8, 7, 'F'], [-1, -22, 2, 2, 'F'], [4, -22, 2, 2, 'F'],   // 頭、耳朵
    [1, -4, 2, 4, 'F'],                                // 一隻前腳放在腿上
    [5, -12 - L, 2, L, 'F'],                           // 另一隻往上抓握把
  ];
  const det = [
    [1, -11, 3, 6, 'W'], [3, -16, 4, 3, 'W'], [6, -16, 1, 1, 'P'],
    [-7, -7, 1, 3, 'D'], [-4, -7, 1, 3, 'D'], [0, -21, 1, 1, 'P'], [5, -21, 1, 1, 'P'],
    [1, -1, 2, 1, 'W'], [5, -12 - L, 2, 1, 'W'],
  ];
  if (strain) det.push([4, -17, 2, 1, 'E'], [5, -14, 2, 1, 'O']);   // 閉眼咬牙
  else det.push([4, -18, 2, 1, 'E'], [4, -17, 2, 1, 'G']);          // 仰頭看著握把
  return [parts, det];
}
const latBarTop = () => cat.state === 'pull' ? Math.round(cat.y) - 14 - Math.round(cat.L) : null;   // 拉著時握把頂端在哪（世界座標）
function stepPull(g) {
  cat.dir = 1; cat.x = g.x + MOUNT.lat.x;
  if (g.weight < 3) {                                  // 拉得動：從手伸直拉到下巴，再放回去
    cat.y = g.y + MOUNT.lat.y;
    const r = cat.t % PULL;
    cat.L = 11 + 6 * Math.cos(2 * Math.PI * r / PULL);
    cat.strain = 0;
    if (r === PULL / 2) note('pulls');                 // 拉到底：算一下
    cat.energy -= 0.01 * (1 + g.weight);
    if (cat.t % 41 === 0) sweat(8, -21);
    if (cat.t > cat.dur && r === 0) { note('lat_sets'); sparkle(cat.x + 3, cat.y - 26); leaveGear('lat'); }
    return;
  }
  cat.L = 17;                                          // 太重了：拉不動，咬牙發抖……
  cat.strain++;
  if (cat.strain % 30 === 0) sweat(8, -21);
  const up = clamp((cat.strain - 90) / 8, 0, 4);       // ……然後整隻被拉離座椅
  cat.y = g.y + MOUNT.lat.y - up;
  if (cat.strain > 140) { g.weight = 1; cat.strain = 0; oops(g, -0.8); }   // 鬆手掉下來
}
function drawLat(g) {                                  // 高拉背機：座椅、柱子、頂上的滑輪、鋼索和握把、配重片
  const x = Math.round(g.x), y = Math.round(g.y);
  const top = latBarTop(), barTop = top === null ? y + LAT_REST : top;
  const s = cat.state === 'pull' && g.weight < 3 ? Math.round((17 - cat.L) * 0.7) : 0;   // 拉下來多少，配重片就升多高
  const plates = [];
  for (let i = 0; i < 3; i++) plates.push([11, -4 - (i + 1) * 4 - s, 4, 3, 'Gp']);
  drawRects(x, y, [
    [-12, -2, 28, 2, 'Gp'],                            // 底座
    [-7, -8, 2, 6, 'Gp'], [-11, -10, 10, 2, 'Bp'],     // 座椅
    [8, -44, 3, 42, 'Gp'],                             // 柱子
    [0, -44, 11, 2, 'Gp'],                             // 頂上往前伸出去的橫桿
    ...plates,
  ], [[9, -42, 1, 40, 'Gl'], [-10, -10, 8, 1, 'Bq'], [0, -42, 3, 1, 'Gh'],
    [11, -4 - g.weight * 4 - s, 1, 3, 'Hb']]);       // 插在第幾片的紅插銷：重量
  ctx.fillStyle = C.O;
  ctx.fillRect(x + 1, y - 42, 1, Math.max(0, barTop - (y - 42)));   // 鋼索
  if (top === null) drawRects(x - 1, y + LAT_REST, [[0, 0, 5, 2, 'Gp']], [[1, 0, 3, 1, 'Gl']]);   // 沒人拉：握把掛在頂上
}

function sweat(dx, dy) {                               // 冒汗：一滴藍藍的往旁邊彈出去
  grit(cat.x + cat.dir * dx, cat.y + dy, C.B, rand(-0.4, 0.4), rand(-0.9, -0.4), 30);
}

/* ── 三件共用：主程式的「DLC 家具」會叫這些（this 是那件器材，this.kind 是它的代號） ── */
const DRAW = { bench: drawBench, mill: drawMill, lat: drawLat };
const STEP = { bench: stepPress, mill: stepRun, lat: stepPull };
const GEAR = {
  draw() { DRAW[this.kind](this); },
  hit(p) { return HIT[this.kind].some(([x0, y0, x1, y1]) => inBox(p, { x0: this.x + x0, y0: this.y + y0, x1: this.x + x1, y1: this.y + y1 })); },
  click() {                                            // 點一下：叫貓過來練；正在練的話，跑步機加速、拉背機加重量
    if (this.kind === 'mill' && using('mill')) this.speed = Math.min(3, this.speed + 1);
    else if (this.kind === 'lat' && using('lat')) this.weight = Math.min(3, this.weight + 1);
    else goGear(this.kind);
    return true;
  },
  idle() { return !this.cd && cat.energy > 40 && goGear(this.kind); },   // 時間到了就自己去練
  step() {
    const k = this.kind;
    this.cd = Math.max(0, this.cd - 1);
    if (k === 'mill' && !using(k)) this.speed = 1;     // 沒人在跑：回到最慢
    if (this.flung && !['fall', 'held'].includes(cat.state)) {   // 從這件被甩出去、鬆手掉下來：落地炸毛
      this.flung = false;
      if (cat.state === 'sit' && !cat.perch) { cat.dir = 1; setState('spook', rand(70, 100)); }
    }
    if (cat.in === k && cat.state !== USE[k] && cat.state !== 'hop') return tumble();   // 被叫去睡覺（安靜模式）之類的：已經不在練了，先掉下來
    if (cat.state === GO[k]) {                         // 走到上來的那一頭，跳上去
      if (!gearReady(k)) setState('sit', 60);
      else if (goTo(this.x + MOUNT[k].from, 0.6)) mount(this);
      else if (cat.t > cat.dur) setState('sit', 60);
    } else if (using(k)) gearReady(k) ? STEP[k](this) : tumble();   // 練到一半器材被拖走了：貓掉下來
  },
  pose(f) {
    const k = this.kind;
    if (cat.state === GO[k]) return standPose(f);
    if (cat.state !== USE[k]) return null;
    if (k === 'bench') {
      const L = Math.round(armLen()), r = cat.t - PRESS_UP;
      return pressPose(L, cat.lift && r >= 0 && r < cat.reps * REP && L <= 5);   // 推到最低、要往上推的時候最吃力
    }
    if (k === 'mill') return standPose(Math.floor(cat.t * MILL_SPEED[this.speed] / 9));   // 速度越快腳步越快
    const L = Math.round(cat.L);
    return pullPose(L, this.weight >= 3 || L <= 7);    // 太重、或拉到最底下時咬牙
  },
  box() {
    if (cat.state !== USE[this.kind]) return null;
    const [x0, y0, x1, y1] = BOX[this.kind];
    return { x0: cat.x + x0, y0: cat.y + y0, x1: cat.x + x1, y1: cat.y + y1 };
  },
  over() {                                             // 臥推：槓片在兩隻前掌正上方；拉背：握把在前掌上面
    if (this.kind === 'bench' && cat.state === 'press' && cat.lift) {
      const y = -5 - Math.round(armLen()) - 3;
      return [shift(PLATE_P, 2, y), shift(PLATE_D, 2, y)];
    }
    if (this.kind === 'lat' && cat.state === 'pull') {
      const y = -14 - Math.round(cat.L);
      return [[[4, y, 5, 2, 'Gp']], [[5, y, 3, 1, 'Gl']]];
    }
    return null;
  },
  off() { this.flung = false; },                       // 收起來了：被甩出去的那一下不算了
  key(c) { if (c === KEY[this.kind]) goGear(this.kind); },
};
// cd：還有幾格才想自己來練（第一次 1～4 分鐘後）；flung：貓從這件被甩出去，還沒落地
const gear = (kind, name, desc, more) => ({ ...GEAR, kind, name, desc, cd: rand(3600, 14400), flung: false, ...more });
FURN.bench = gear('bench', '臥推椅', '躺上去推槓鈴');
FURN.mill = gear('mill', '跑步機', '原地跑步，點一下加速', { speed: 1, phase: 0 });   // speed：速度 1～3；phase：跑帶的紋路捲到哪
FURN.lat = gear('lat', '高拉背機', '往下拉，點一下加重量', { weight: 1 });          // weight：重量 1～3
